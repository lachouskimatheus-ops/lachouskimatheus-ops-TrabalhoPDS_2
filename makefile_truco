CXX = g++

CXXFLAGS = -std=c++17 -Wall -Wextra -pthread \
	-I./API \
	-I./API/dependencias \
	-I./Jogos/Truco/include \
	-I./Jogos/Core/include

LIBS =

ifeq ($(OS),Windows_NT)
	LIBS = -lws2_32 -lmswsock
endif

TRUCO_SRCS = servidor_truco.cpp \
	Jogos/Truco/src/BaralhoSujo.cpp \
	Jogos/Truco/src/Jogador_Truco.cpp \
	Jogos/Truco/src/Juiz.cpp \
	Jogos/Truco/src/JuizMineiro.cpp \
	Jogos/Truco/src/JuizPaulista.cpp \
	Jogos/Truco/src/Mesa.cpp \
	Jogos/Core/src/Baralho.cpp \
	Jogos/Core/src/Carta.cpp

TARGET = servidor_truco

all: $(TARGET)

$(TARGET):
	$(CXX) $(CXXFLAGS) $(TRUCO_SRCS) -o $(TARGET) $(LIBS)
	@echo "Servidor do Truco compilado! Rode com ./$(TARGET)"

run: all
	./$(TARGET)

clean:
	rm -f $(TARGET)
